# Copy to .env and fill in. The .env file must never be committed or zipped.
# gemini or groq = real model; mock = offline placeholder model for testing the pipeline (no key needed)
LLM_PROVIDER=groq
# Used when LLM_PROVIDER=gemini
GEMINI_MODEL=
# Used when LLM_PROVIDER=groq (for example GROQ_MODEL=openai/gpt-oss-120b)
GEMINI_API_KEY=
GROQ_API_KEY=
GROQ_MODEL=
# Limits
MAX_UPLOAD_MB=10
MAX_VBA_LINES=20000
RETENTION_DAYS=7
# Stages in order
ENABLED_STAGES=intake_check,extractor,analyzer,spec_architect,generator,validator,packager
WORKSPACE_ROOT=./workspace
CORS_ORIGINS=http://localhost:5173
# LLM behavior
LLM_RETRIES=4
LLM_CALL_DELAY_SECONDS=4
LLM_BACKOFF_BASE_SECONDS=2
LLM_BACKOFF_MAX_SECONDS=60
CHUNK_MAX_CHARS=12000
# Tokens per minute your provider plan allows. 0 = use the limit the provider reports (Groq does).
# Calls wait just long enough to stay under it instead of running into rate-limit errors.
LLM_TOKENS_PER_MINUTE=0
# Largest input for one request. 0 = half of the tokens-per-minute limit. Larger chunks are split.
LLM_MAX_INPUT_TOKENS=0
SCHEMA_REASK=2
# 0 means no token limit
MAX_TOKENS_PER_RUN=0
# Validator: seconds allowed for each of dotnet restore and dotnet build
DOTNET_TIMEOUT_SEC=300
