{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "vba_modules",
  "type": "object",
  "required": ["schema_version", "source_file", "modules", "findings", "flags"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "source_file": {"type": "string"},
    "modules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "type", "stream", "line_count", "code"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "type": {"enum": ["standard", "class", "sheet", "workbook", "form"]},
          "stream": {"type": "string"},
          "line_count": {"type": "integer", "minimum": 0},
          "code": {"type": "string"}
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "keyword", "description"],
        "properties": {
          "type": {"type": "string"},
          "keyword": {"type": "string"},
          "description": {"type": "string"}
        }
      }
    },
    "flags": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code", "severity", "reason"],
        "properties": {
          "code": {"type": "string"},
          "severity": {"enum": ["Info", "Warning", "Blocker"]},
          "reason": {"type": "string"}
        }
      }
    }
  }
}
